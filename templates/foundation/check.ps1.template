# The repository's one local health gate, kept at scripts/check.ps1. Replace each
# placeholder with one command already used or deliberately approved by this
# repository's CI. If a step cannot run yet, delete its line and record it under
# "Open decisions" in PROJECT-CHARTER.md; never substitute a command that always
# succeeds.
[CmdletBinding()]
param()

# Split multiple native commands into separate Steps so none masks another.
$ErrorActionPreference = 'Stop'
# Refuse to run until the three command placeholders are replaced. An unreplaced step
# would otherwise parse as an empty script block and report success. Other {{...}}
# text in a real command is allowed.
if ((Get-Content -Raw -LiteralPath $PSCommandPath) -match '\{\{(FORMAT|LINT|TEST)_COMMAND\}\}') {
    Write-Host 'FAIL: replace the remaining {{...}} placeholders in this gate first.'
    exit 1
}
Set-Location -LiteralPath (Split-Path -Parent $PSScriptRoot)
$failures = 0
$steps = 0
function Step([string]$Name, [scriptblock]$Action) {
    $script:steps++
    Write-Host "`n== $Name =="
    $global:LASTEXITCODE = 0
    try {
        & $Action
        if ($LASTEXITCODE -ne 0) { throw "Native command exited with $LASTEXITCODE" }
    }
    catch {
        $script:failures++
        Write-Host "FAIL: $_"
    }
}

Step 'format' { {{FORMAT_COMMAND}} }
Step 'lint'   { {{LINT_COMMAND}} }
Step 'test'   { {{TEST_COMMAND}} }
# Add security or packaging checks only after verifying their policy inputs.
# A gate whose steps were all deleted checks nothing, so it must not pass.
if ($steps -eq 0) {
    Write-Host 'FAIL: this gate has no steps, so it checks nothing.'
    exit 1
}
exit $failures
