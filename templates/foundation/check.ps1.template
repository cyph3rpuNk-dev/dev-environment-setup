# The repository's one local health gate. Replace each placeholder with a command
# already used or deliberately approved by this repository's CI.
[CmdletBinding()]
param()

# Copy this gate to scripts/check.ps1. Each placeholder is one command;
# split multiple native commands into separate Steps so none masks another.
$ErrorActionPreference = 'Stop'
# Refuse to run until every placeholder is replaced. An unreplaced step would
# otherwise parse as an empty script block and report success.
if ((Get-Content -Raw -LiteralPath $PSCommandPath) -match '\{\{[A-Z_]+\}\}') {
    Write-Host 'FAIL: replace the remaining {{...}} placeholders in this gate first.'
    exit 1
}
Set-Location -LiteralPath (Split-Path -Parent $PSScriptRoot)
$failures = 0
function Step([string]$Name, [scriptblock]$Action) {
    Write-Host "`n== $Name =="
    $global:LASTEXITCODE = 0
    try {
        & $Action
        if ($LASTEXITCODE -ne 0) { throw "Native command exited with $LASTEXITCODE" }
    }
    catch {
        $script:failures++
        Write-Host "FAIL: $_"
    }
}

Step 'format' { {{FORMAT_COMMAND}} }
Step 'lint'   { {{LINT_COMMAND}} }
Step 'test'   { {{TEST_COMMAND}} }
# Add security or packaging checks only after verifying their policy inputs.
exit $failures
